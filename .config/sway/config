# Sway config for ASUS/AMD Fedora
# Super = $mod
set $mod Mod4

# Default to pixel borders
default_border pixel 1
default_floating_border pixel 1

# Rose Pine window border colors
# class                 border    bg        text      indicator child_border
client.focused          #524f67   #26233a   #e0def4   #ebbcba   #ebbcba
client.unfocused        #26233a   #1f1d2e   #6e6a86   #26233a   #26233a
client.focused_inactive #26233a   #1f1d2e   #908caa   #26233a   #26233a
client.urgent           #eb6f92   #eb6f92   #e0def4   #eb6f92   #eb6f92
hide_edge_borders smart

# Gaps
gaps inner 1
gaps outer 1
smart_gaps on
smart_borders on

# Outputs
# Laptop screen (left)
output eDP-1 position 0 0 resolution 1920x1200@60Hz scale 1
# External LG IPS FULLHD (right)
output HDMI-A-1 position 1920 0 resolution 1920x1080@60Hz scale 1

# Workspace split: 1-5 on external, 6-10 on laptop
workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-1
workspace 3 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1
workspace 6 output eDP-1
workspace 7 output eDP-1
workspace 8 output eDP-1
workspace 9 output eDP-1
workspace 10 output eDP-1

# Input: Trackpad natural scroll, keyboard US (change xkb_layout)
input type:keyboard {
    xkb_layout us
    repeat_delay 200
    repeat_rate 50
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    click_method clickfinger
}
input type:mouse {
    natural_scroll enabled
}

# Allow moving/resizing windows with the mouse
# $mod + Left Click to move, $mod + Right Click to resize
floating_modifier $mod

# Terminal: Ghostty (your fave)
set $term ghostty

# Keybinds
# Launcher: Cmd+Space
bindsym $mod+space exec wofi --show drun

# Terminal: Cmd+T
bindsym $mod+t exec $term

# Workspaces: Cmd+1-0
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move to workspaces: Cmd+Shift+1-0
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Split: Cmd+B (horizontal), Cmd+V (vertical)
bindsym $mod+Shift+b splith
bindsym $mod+Shift+v splitv

# Focus: Arrows/Vim (crosses monitor boundaries)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move window between outputs
bindsym $mod+Shift+period move container to output right; focus output right
bindsym $mod+Shift+comma move container to output left; focus output left

# Focus output directly
bindsym $mod+period focus output right
bindsym $mod+comma focus output left

# Resize Mode: Cmd+R
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Toggle: Float/Tile/Fullscreen/Kill
bindsym $mod+Shift+space floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill

# Reload/Exit
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaymsg exit

# Volume/Brightness (PipeWire & brightnessctl)
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Screen Brightness
bindsym XF86MonBrightnessUp exec brightnessctl -d amdgpu_bl1 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -d amdgpu_bl1 set 5%-

# Keyboard Backlight
bindsym XF86KbdBrightnessUp exec brightnessctl -d asus::kbd_backlight set 10%+
bindsym XF86KbdBrightnessDown exec brightnessctl -d asus::kbd_backlight set 10%-

# Lock: Cmd+L
# bindsym $mod+l exec swaylock

# Screenshot: PrintScreen
bindsym Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Autostart
exec /usr/libexec/sway-systemd/session.sh
exec waybar
exec nm-applet
exec mako  # Notifications

# bar {
#     position top
#     font "FiraCode Nerd Font:monospace 8"
#     status_command /home/lostcache/.config/sway/status.sh
# }

# Client rules (e.g., float some apps)
for_window [class="^floating$"] floating enable
for_window [app_id="ghostty"] focus

bindsym $mod+c exec wl-copy
bindsym $mod+v exec wl-paste

