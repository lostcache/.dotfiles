// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "vim_mode": true,
  "icon_theme": "Colored Zed Icons Theme Dark",
  "show_signature_help_after_edits": true,
  "colorize_brackets": true,
  "minimap": {
    "display_in": "all_editors",
    "show": "always",
  },
  "centered_layout": {
    "right_padding": 0.0,
    "left_padding": 0.0,
  },
  "agent": {
    "dock": "right",
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "bottom_dock_layout": "full",
  "always_treat_brackets_as_autoclosed": true,
  "completion_menu_scrollbar": "auto",
  "extend_comment_on_newline": false,
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_from_file_finder": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "show_completions_on_input": true,
  "show_edit_predictions": true,
  // "cursor_shape": "block",
  "ssh_connections": [
    {
      "host": "ubuntu-24-l",
      "args": ["-o", "ServerAliveInterval=1200", "-o", "ServerAliveCountMax=3"],
      "projects": [
        {
          "paths": ["/root"],
        },
        {
          "paths": ["/root/code/1brc"],
        },
      ],
    },
  ],
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
    "enabled_in_text_threads": false,
  },
  "telemetry": {
    "metrics": true,
  },

  "features": {
    "edit_prediction_provider": "copilot",
  },

  "lsp": {
    "zls": {
      "binary": {
        "path": "~/.zvm/bin/zls",
      },
      "settings": {
        "zls": {
          "enable_build_on_save": true,
          "zig_exe_path": "~/.zvm/bin/zig",
        },
      },
    },
  },

  "theme": "Gruvbox Dark Hard",
  "ui_font_size": 11.0,
  "buffer_font_size": 11.0,
  "buffer_line_height": "standard",
  "autosave": "off",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
    "copy_on_select": true,
  },

  // git
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false,
    },
  },

  // specific language config
  "languages": {
    "JSONC": {
      "show_edit_predictions": true,
    },
    "Go": {
      "show_edit_predictions": true,
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
      "language_servers": ["!typescript-language-server", "..."],
      "format_on_save": "on",
    },
    "Zig": {
      "show_edit_predictions": true,
      "formatter": "language_server",
      "language_servers": ["zls"],
      "inlay_hints": {
        "enabled": false,
      },
      "format_on_save": "on",
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
      "format_on_save": "on",
    },
    "Rust": {
      "formatter": {
        "external": {
          "command": "rustfmt",
          // "arguments": ["-"],
        },
      },
      "inlay_hints": {},
      "format_on_save": "on",
    },
    "C++": {
      "language_servers": ["clangd"],
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--style=file", "--assume-filename={buffer_path}", "-"],
        },
      },
      "format_on_save": "on",
    },
    "C": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["-"],
        },
      },
      "format_on_save": "on",
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["pyright"],
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"],
        },
      },
      "format_on_save": "on",
    },
    "OCaml": {
      "formatter": {
        "external": {
          "command": "ocamlformat",
          "arguments": [
            "--enable-outside-detected-project",
            "--name",
            "{buffer_path}",
            "-",
          ],
        },
      },
      "format_on_save": "on",
    },
    "LaTeX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--stdin"],
        },
      },
    },
  },
}
