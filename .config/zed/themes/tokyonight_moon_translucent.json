{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Tokyonight Moon Translucent",
  "author": "Folke Lemaitre, Harsh Devisha",
  "themes": [
    {
      "name": "Tokyonight Moon Translucent",
      "appearance": "dark",
      "style": {
        "background": "#000000bb",
        "background.appearance": "blurred",
        "border": "#1e2030",
        "border.focused": "#82aaff",
        "elevated_surface.background": "#2f334d",
        "surface.background": "#222436",
        "element.background": "#2f334d",
        "element.hover": "#394b70",
        "element.active": "#65bcff",
        "element.selected": "#394b70",
        "text": "#c8d3f5",
        "text.muted": "#828bb8",
        "text.placeholder": "#636da6",
        "icon": "#c8d3f5",
        "status_bar.background": "#000000bb",
        "title_bar.background": "#000000bb",
        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#00000000",
        "tab.active_background": "#2f334d50",
        "search.match_background": "#3e68d780",
        "panel.background": "#00000000",
        "panel.focused_border": "#82aaff",
        "pane.focused_border": "#82aaff",
        "editor.foreground": "#c8d3f5",
        "editor.background": "#00000000",
        "editor.gutter.background": "#00000000",
        "editor.active_line.background": "#00000000",
        "editor.highlighted_line.background": "#2f334d80",
        "editor.line_number": "#3b4261",
        "editor.active_line_number": "#82aaff",
        "editor.invisible": "#545c7e",
        "editor.wrap_guide": "#3b4261",
        "editor.active_wrap_guide": "#636da6",
        "editor.document_highlight.read_background": "#394b7080",
        "editor.document_highlight.write_background": "#82aaff30",
        "error": "#ff757f",
        "warning": "#ffc777",
        "info": "#0db9d7",
        "hint": "#4fd6be",
        "created": "#b8db87",
        "deleted": "#e26a75",
        "modified": "#7ca1f2",
        "players": [
          { "cursor": "#82aaff", "selection": "#394b7080" },
          { "cursor": "#c099ff", "selection": "#394b7080" },
          { "cursor": "#c3e88d", "selection": "#394b7080" },
          { "cursor": "#ffc777", "selection": "#394b7080" },
          { "cursor": "#ff757f", "selection": "#394b7080" },
          { "cursor": "#86e1fc", "selection": "#394b7080" },
          { "cursor": "#ff966c", "selection": "#394b7080" }
        ],
        "syntax": {
          "attribute": { "color": "#86e1fc" },
          "boolean": { "color": "#ff966c" },
          "comment": { "color": "#636da6", "font_style": "italic" },
          "comment.doc": { "color": "#636da6", "font_style": "italic" },
          "constant": { "color": "#ff966c" },
          "constant.builtin": { "color": "#65bcff" },
          "constructor": { "color": "#c099ff" },
          "embedded": {},
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": "bold" },
          "function": { "color": "#82aaff" },
          "keyword": { "color": "#fca7ea" },
          "keyword.function": { "color": "#c099ff" },
          "keyword.operator": { "color": "#89ddff" },
          "keyword.return": { "color": "#fca7ea" },
          "label": { "color": "#82aaff" },
          "link_text": { "color": "#4fd6be" },
          "link_uri": { "color": "#4fd6be", "font_style": "underline" },
          "number": { "color": "#ff966c" },
          "operator": { "color": "#89ddff" },
          "preproc": { "color": "#86e1fc" },
          "property": { "color": "#4fd6be" },
          "punctuation": { "color": "#828bb8" },
          "punctuation.bracket": { "color": "#828bb8" },
          "punctuation.delimiter": { "color": "#89ddff" },
          "punctuation.special": { "color": "#89ddff" },
          "string": { "color": "#c3e88d" },
          "string.escape": { "color": "#c099ff" },
          "string.regex": { "color": "#b4f9f8" },
          "string.special": { "color": "#c3e88d" },
          "tag": { "color": "#ff757f" },
          "text.literal": { "color": "#c3e88d" },
          "title": { "color": "#82aaff", "font_weight": "bold" },
          "type": { "color": "#65bcff" },
          "type.builtin": { "color": "#65bcff" },
          "variable": { "color": "#c8d3f5" },
          "variable.builtin": { "color": "#ff757f" },
          "variable.member": { "color": "#4fd6be" },
          "variable.parameter": { "color": "#ffc777" }
        }
      }
    }
  ]
}